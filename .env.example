# Copie este arquivo para .env e preencha com os valores reais.
# Usado tanto por `npm run dev` quanto por `docker compose up`.

DB_URL=https://<projeto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<chave>
JWT_SECRET=<segredo>

# SMTP para envio de e-mail OTP (opcional — sem isso, o codigo aparece no log do container verificacao-email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu@gmail.com
SMTP_PASS=senha_de_app_do_gmail
